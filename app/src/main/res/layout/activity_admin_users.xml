<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jf_cream"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:text="Quản lý người dùng"
        android:textColor="@color/jf_ink"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:background="@drawable/bg_btn_outline">

        <EditText
            android:id="@+id/etSearchUser"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@null"
            android:drawableStart="@drawable/ic_search_muted"
            android:drawablePadding="10dp"
            android:hint="Tìm theo tên hoặc email..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/jf_ink"
            android:textColorHint="#A58A78"
            android:textSize="15sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Tất cả"
                android:textAllCaps="false"
                android:textColor="@color/jf_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/jf_teal"
                app:cornerRadius="19dp" />
            <Button
                android:id="@+id/btnFilterSeeker"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Ứng viên"
                android:textAllCaps="false"
                android:textColor="@color/jf_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#8A6F5E"
                app:cornerRadius="19dp" />
            <Button
                android:id="@+id/btnFilterEmployer"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Nhà tuyển dụng"
                android:textAllCaps="false"
                android:textColor="@color/jf_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#8A6F5E"
                app:cornerRadius="19dp" />
            <Button
                android:id="@+id/btnFilterBlocked"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Bị khóa"
                android:textAllCaps="false"
                android:textColor="@color/jf_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#8A6F5E"
                app:cornerRadius="19dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvUserCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:text="Đang tải danh sách tài khoản..."
        android:textColor="@color/jf_muted"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="← Quay lại"
        android:textAllCaps="false"
        android:textColor="@color/jf_teal"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/jf_white"
        app:cornerRadius="28dp"
        app:strokeColor="@color/jf_teal"
        app:strokeWidth="1.5dp" />

</LinearLayout>