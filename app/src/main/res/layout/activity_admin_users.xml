<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:orientation="vertical">

    <!-- TIÊU ĐỀ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1976D2"
        android:padding="16dp"
        android:text="Quản lý tài khoản người dùng"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Ô TÌM KIẾM TÀI KHOẢN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/etSearchUser"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/editbox_background_normal"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:hint="Tìm theo tên hoặc email..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- NÚT LỌC VAI TRÒ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1976D2"
                android:text="Tất cả"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFilterSeeker"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#757575"
                android:text="Ứng viên"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFilterEmployer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#757575"
                android:text="Nhà tuyển dụng"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFilterBlocked"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#757575"
                android:text="Bị khóa"
                android:textSize="11sp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- TỔNG SỐ TÀI KHOẢN -->
    <TextView
        android:id="@+id/tvUserCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingBottom="6dp"
        android:text="Đang tải danh sách tài khoản..."
        android:textColor="#555555"
        android:textSize="13sp" />

    <!-- DANH SÁCH USER -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <!-- NÚT QUAY LẠI -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:text="← Quay lại" />

</LinearLayout>
