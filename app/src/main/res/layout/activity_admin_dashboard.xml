<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jf_cream"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TIÊU ĐỀ VÀ NÚT ĐĂNG XUẤT -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quản trị"
                    android:textColor="@color/jf_ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hệ thống quản trị JobFinder"
                    android:textColor="@color/jf_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- VIỆC CẦN XỬ LÝ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Việc cần xử lý ngay"
            android:textColor="@color/jf_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardPendingJobs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_peach"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bài chờ duyệt"
                    android:textColor="#9A4B00"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPendingJobs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0"
                    android:textColor="#7A3A00"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPendingReports"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rose"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khiếu nại chờ giải quyết"
                    android:textColor="#B3261E"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPendingReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0"
                    android:textColor="#8C1D18"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- THỐNG KÊ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Thống kê tổng quan"
            android:textColor="@color/jf_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginStart="0dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Người dùng"
                    android:textColor="@color/jf_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTotalUsers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="@color/jf_teal"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="0dp"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bài tuyển dụng"
                    android:textColor="@color/jf_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTotalJobs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#9A4B00"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginStart="0dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lượt ứng tuyển"
                    android:textColor="@color/jf_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTotalApplications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#0D47A1"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="0dp"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhà tuyển dụng"
                    android:textColor="@color/jf_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTotalRecruiters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#6A3A8E"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CHỨC NĂNG QUẢN TRỊ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Chức năng quản trị"
            android:textColor="@color/jf_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_card">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnManageUsers"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_adm_users"
                android:drawableEnd="@drawable/ic_chevron"
                android:drawablePadding="14dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Quản lý tài khoản người dùng"
                android:textAllCaps="false"
                android:textColor="@color/jf_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="#F5E6D8" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnManageJobs"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_adm_jobs"
                android:drawableEnd="@drawable/ic_chevron"
                android:drawablePadding="14dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Kiểm duyệt bài đăng tuyển dụng"
                android:textAllCaps="false"
                android:textColor="@color/jf_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="#F5E6D8" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnManageReports"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_adm_flag"
                android:drawableEnd="@drawable/ic_chevron"
                android:drawablePadding="14dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Báo cáo &amp; Khiếu nại"
                android:textAllCaps="false"
                android:textColor="@color/jf_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_btn_danger"
            android:text="Đăng xuất"
            android:textAllCaps="false"
            android:textColor="#B3261E"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>