<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TIÊU ĐỀ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Dashboard"
            android:textColor="#222222"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Hệ thống quản trị JobFinder"
            android:textColor="#777777"
            android:textSize="15sp" />

        <!-- THỐNG KÊ 1: TỔNG SỐ NGƯỜI DÙNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng số người dùng"
                android:textColor="#666666"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTotalUsers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0"
                android:textColor="#1976D2"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- THỐNG KÊ 2: TỔNG SỐ BÀI ĐĂNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng số bài tuyển dụng"
                android:textColor="#666666"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTotalJobs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0"
                android:textColor="#388E3C"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- THỐNG KÊ 3: TỔNG SỐ LƯỢT ỨNG TUYỂN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng lượt người ứng tuyển"
                android:textColor="#666666"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTotalApplications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0"
                android:textColor="#E65100"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- THỐNG KÊ 4: NHÀ TUYỂN DỤNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tài khoản Nhà tuyển dụng"
                android:textColor="#666666"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTotalRecruiters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0"
                android:textColor="#7B1FA2"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CÁC NÚT ĐIỀU HƯỚNG QUẢN LÝ -->
        <Button
            android:id="@+id/btnManageUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Quản lý tài khoản người dùng"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnManageJobs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Kiểm duyệt bài đăng tuyển dụng"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnManageReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Báo cáo &amp; Khiếu nại"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
