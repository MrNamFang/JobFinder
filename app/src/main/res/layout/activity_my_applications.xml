<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đơn ứng tuyển của tôi"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Giữ để hủy đơn (chỉ áp dụng khi đang chờ duyệt)"
        android:textSize="12sp"
        android:textColor="#999999"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/tvEmptyApplications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bạn chưa ứng tuyển công việc nào"
        android:textAlignment="center"
        android:textColor="#999999"
        android:padding="20dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewApplications"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp" />

</LinearLayout>