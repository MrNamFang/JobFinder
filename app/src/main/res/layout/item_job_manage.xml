<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvManageJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:textColor="@color/jf_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvJobStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="@color/jf_teal"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvManageJobCompany"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/jf_body"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvManageJobLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawableStart="@drawable/ic_location"
        android:drawablePadding="4dp"
        android:drawableTint="@color/jf_muted"
        android:textColor="@color/jf_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleStatus"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:textAllCaps="false"
            android:textColor="@color/jf_teal"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/jf_white"
            app:strokeColor="@color/jf_teal"
            app:strokeWidth="1.5dp"
            app:cornerRadius="21dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditJob"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:text="Sửa"
            android:textAllCaps="false"
            android:textColor="@color/jf_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/jf_white"
            app:strokeColor="@color/jf_ink"
            app:strokeWidth="1.5dp"
            app:cornerRadius="21dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteJob"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp"
            android:text="Xóa"
            android:textAllCaps="false"
            android:textColor="@color/jf_danger"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/jf_white"
            app:strokeColor="@color/jf_danger"
            app:strokeWidth="1.5dp"
            app:cornerRadius="21dp" />
    </LinearLayout>
</LinearLayout>