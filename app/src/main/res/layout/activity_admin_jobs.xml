<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jf_cream"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:text="Kiểm duyệt bài đăng"
        android:textColor="@color/jf_ink"
        android:textSize="26sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnJobFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Tất cả"
                android:textAllCaps="false"
                android:textColor="@color/jf_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/jf_teal"
                app:cornerRadius="19dp" />
            <Button
                android:id="@+id/btnJobFilterPending"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Chờ duyệt"
                android:textAllCaps="false"
                android:textColor="@color/jf_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#8A6F5E"
                app:cornerRadius="19dp" />
            <Button
                android:id="@+id/btnJobFilterApproved"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Đã duyệt"
                android:textAllCaps="false"
                android:textColor="@color/jf_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#8A6F5E"
                app:cornerRadius="19dp" />
            <Button
                android:id="@+id/btnJobFilterRejected"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Bị từ chối"
                android:textAllCaps="false"
                android:textColor="@color/jf_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#8A6F5E"
                app:cornerRadius="19dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvJobCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:text="Đang tải danh sách bài đăng..."
        android:textColor="@color/jf_muted"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJobs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="← Quay lại"
        android:textAllCaps="false"
        android:textColor="@color/jf_teal"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/jf_white"
        app:cornerRadius="28dp"
        app:strokeColor="@color/jf_teal"
        app:strokeWidth="1.5dp" />

</LinearLayout>