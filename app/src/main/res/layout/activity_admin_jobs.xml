<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:orientation="vertical">

    <!-- TIÊU ĐỀ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#388E3C"
        android:padding="16dp"
        android:text="Kiểm duyệt bài đăng tuyển dụng"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- CÁC NÚT LỌC TRẠNG THÁI -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnJobFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#388E3C"
                android:text="Tất cả"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnJobFilterPending"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#757575"
                android:text="Chờ duyệt (Vàng)"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnJobFilterApproved"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#757575"
                android:text="Đã duyệt (Xanh)"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnJobFilterRejected"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#757575"
                android:text="Bị từ chối (Đỏ)"
                android:textSize="11sp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- TỔNG SỐ BÀI ĐĂNG -->
    <TextView
        android:id="@+id/tvJobCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingBottom="6dp"
        android:text="Đang tải danh sách bài đăng..."
        android:textColor="#555555"
        android:textSize="13sp" />

    <!-- DANH SÁCH BÀI ĐĂNG -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJobs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <!-- NÚT QUAY LẠI -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:text="← Quay lại" />

</LinearLayout>
