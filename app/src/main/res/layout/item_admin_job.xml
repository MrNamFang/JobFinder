<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvJobTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="Tên công việc"
        android:textColor="@color/jf_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvJobCompany"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Công ty"
        android:textColor="@color/jf_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvJobLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Địa điểm"
        android:textColor="@color/jf_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvJobStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Trạng thái"
        android:textColor="#2E7D32"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Chạm vào thẻ để xem chi tiết và duyệt"
        android:textColor="#A58A78"
        android:textSize="12sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDeleteJob"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_danger"
        android:text="Xóa bài đăng"
        android:textAllCaps="false"
        android:textColor="#B3261E"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>