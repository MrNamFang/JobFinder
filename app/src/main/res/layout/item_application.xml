<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card">

    <TextView
        android:id="@+id/tvAppJobTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Job Title"
        android:textColor="@color/jf_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAppCompanyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Company Name"
        android:textColor="@color/jf_body"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvAppDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Ngày ứng tuyển"
        android:textColor="@color/jf_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvAppStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tag"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="Đang chờ"
        android:textColor="@color/jf_ink"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>