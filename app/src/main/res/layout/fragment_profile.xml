<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jf_cream"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Đầu trang: ảnh đại diện + thông tin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp"
            android:background="@drawable/bg_header">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:text="?"
                android:textColor="@color/jf_white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="..."
                android:textColor="@color/jf_mint_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="..."
                android:textColor="#1F5A53"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvProfilePhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="..."
                android:textColor="@color/jf_mint_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mức hoàn thiện hồ sơ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-14dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:elevation="2dp"
            android:background="@drawable/bg_card_peach">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mức hoàn thiện hồ sơ"
                    android:textColor="@color/jf_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/jf_teal"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                app:indicatorColor="@color/jf_teal"
                app:trackColor="@color/jf_white"
                app:trackThickness="10dp"
                app:trackCornerRadius="5dp" />

            <TextView
                android:id="@+id/tvProgressHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#5A3A28"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Hồ sơ CV -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hồ sơ CV"
                android:textColor="@color/jf_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Học vấn"
                android:textColor="@color/jf_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEducation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="VD: Đại học Bách Khoa - CNTT"
                android:minLines="2"
                android:padding="14dp"
                android:textColor="@color/jf_ink"
                android:textColorHint="#A58A78"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Kinh nghiệm làm việc"
                android:textColor="@color/jf_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="VD: Thực tập sinh Android tại công ty ABC (6 tháng)"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="@color/jf_ink"
                android:textColorHint="#A58A78"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Kỹ năng"
                android:textColor="@color/jf_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSkills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="VD: Java, Android, Firebase, Git"
                android:minLines="2"
                android:padding="14dp"
                android:textColor="@color/jf_ink"
                android:textColorHint="#A58A78"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveCv"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Lưu hồ sơ CV"
                android:textAllCaps="false"
                android:textColor="@color/jf_white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/jf_teal"
                app:cornerRadius="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Hồ sơ này được gửi kèm mỗi khi bạn ứng tuyển."
                android:textColor="@color/jf_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_card">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMyApplications"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_doc"
                android:drawableEnd="@drawable/ic_chevron"
                android:drawableTint="@color/jf_ink"
                android:drawablePadding="14dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Đơn ứng tuyển của tôi"
                android:textAllCaps="false"
                android:textColor="@color/jf_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="#F5E6D8" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNotifications"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_bell"
                android:drawableEnd="@drawable/ic_chevron"
                android:drawableTint="@color/jf_ink"
                android:drawablePadding="14dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Thông báo"
                android:textAllCaps="false"
                android:textColor="@color/jf_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="#F5E6D8" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFeedback"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_chat"
                android:drawableEnd="@drawable/ic_chevron"
                android:drawableTint="@color/jf_ink"
                android:drawablePadding="14dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Góp ý ứng dụng"
                android:textAllCaps="false"
                android:textColor="@color/jf_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Đăng xuất -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Đăng xuất"
            android:textAllCaps="false"
            android:textColor="@color/jf_danger"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/jf_white"
            app:strokeColor="@color/jf_danger"
            app:strokeWidth="2dp"
            app:cornerRadius="28dp" />
    </LinearLayout>
</ScrollView>